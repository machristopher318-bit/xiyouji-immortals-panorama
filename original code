      '天庭': {title:'天庭：神圣官僚与皇权镜像',intro:'天庭是《西游记》中最具行政色彩的神圣机构。玉皇大帝居最高政治位置，文官负责招安与传旨，武将负责围剿和护法。',events:['招安孙悟空为弼马温与齐天大圣。','调遣李天王、哪吒、二郎神等围剿花果山。','蟠桃会失序后，天庭权威受到大圣挑战。'],tree:{name:'玉皇大帝',children:[{name:'文官系统',children:[{name:'太白金星'}]},{name:'军事系统',children:[{name:'托塔李天王',children:[{name:'哪吒三太子'}]},{name:'二郎显圣真君'}]},{name:'礼制资源',children:[{name:'王母娘娘'}]}]}},
      '佛教': {title:'佛教：取经制度与救度秩序',intro:'佛教阵营位于取经叙事的终点和意义源头。如来确定取经事业，观音执行组织与救难任务。',events:['如来降伏孙悟空，奠定大闹天宫结局。','观音奉佛旨寻找取经人并安排徒众。','取经功成后，唐僧师徒在灵山受封。'],tree:{name:'如来佛祖',children:[{name:'过去与未来佛',children:[{name:'燃灯古佛'},{name:'弥勒佛'}]},{name:'菩萨系统',children:[{name:'观音菩萨'},{name:'文殊菩萨'},{name:'普贤菩萨'},{name:'地藏王菩萨'}]},{name:'护法系统',children:[{name:'十八罗汉'},{name:'四大金刚'}]}]}},
      '道教': {title:'道教：玄门尊位与法宝体系',intro:'道教在小说中既体现为三清等最高尊位，也体现为丹炉、金刚琢等法宝叙事。',events:['太上老君丹炉锻炼孙悟空。','青牛精携金刚琢下界，令诸天神兵失效。','三清名号强化天界的道教宇宙背景。'],tree:{name:'三清',children:[{name:'太上老君',children:[{name:'青牛精'}]},{name:'元始天尊'},{name:'灵宝天尊'}]}},
      '地府': {title:'地府：生死簿与幽冥司法',intro:'地府是小说中生死秩序的具象化场所。十殿阎罗掌审判，判官管文书，鬼使负责执行。',events:['孙悟空入幽冥强销猴属名籍。','唐太宗入冥受审并还阳。','崔判官改添阳寿，推动水陆大会与取经缘起。'],tree:{name:'地藏王菩萨',children:[{name:'十殿阎罗',children:[{name:'崔判官'},{name:'牛头马面'},{name:'黑白无常'}]}]}},
      '龙宫': {title:'龙宫：水府政权与地方神司',intro:'龙宫连接自然水域、地方神权和天庭法令。四海龙王拥有宝物与兵卒，却也受天律约束。',events:['孙悟空入东海取得如意金箍棒。','泾河龙王违改雨数被魏征梦斩。','白龙马由西海龙子转入取经队伍。'],tree:{name:'四海龙王',children:[{name:'东海龙王敖广'},{name:'西海龙王敖闰',children:[{name:'白龙马'}]},{name:'泾河龙王'}]}},
      '散仙': {title:'散仙：制度之外的修行力量',intro:'散仙与游离势力不完全归入天庭或灵山行政，体现隐逸修行、地仙传统和边缘神圣性。',events:['菩提祖师传授孙悟空根本神通。','镇元大仙以人参果树展示地仙尊位。','取经队伍成员经历从谪降、妖身或人身到佛门功果的转化。'],tree:{name:'游离修行谱系',children:[{name:'菩提祖师',children:[{name:'孙悟空'}]},{name:'镇元大仙'},{name:'取经队伍',children:[{name:'唐僧'},{name:'猪八戒'},{name:'沙僧'},{name:'白龙马'}]}]}}
    };
    const state = {faction:'全部',layer:'全部',query:'',selected:null,zoom:.92,panX:0,panY:0,activeTab:'天庭'};
    const charts = {};
    const $ = (id) => document.getElementById(id);
    const deityById = Object.fromEntries(deities.map((d) => [d.id,d]));

    function getFilteredDeities() {
      const q = state.query.trim();
      return deities.filter((d) => (state.faction === '全部' || d.faction === state.faction) && (state.layer === '全部' || d.layer === state.layer) && (!q || d.name.includes(q) || d.title.includes(q)));
    }
    function sizeForRank(rank) { return 58 + rank * 13; }
    function applyTransform() { $('hierarchyInner').style.transform = `translate(${state.panX}px, ${state.panY}px) scale(${state.zoom})`; }
    function initFilters() {
      $('factionFilters').innerHTML = filterFactions.map((f) => `<button class="faction-btn px-3 py-1.5 text-xs sm:text-sm ${f === state.faction ? 'active' : ''}" data-faction="${f}">${f}</button>`).join('');
      $('factionFilters').addEventListener('click', (event) => {
        const btn = event.target.closest('[data-faction]');
        if (!btn) return;
        state.faction = btn.dataset.faction;
        renderAll();
      });
      const layers = ['全部', ...new Set(deities.map((d) => d.layer))];
      $('layerSelect').innerHTML = layers.map((layer) => `<option value="${layer}">${layer}</option>`).join('');
      $('layerSelect').addEventListener('change', (event) => { state.layer = event.target.value; renderAll(); });
      $('searchInput').addEventListener('input', (event) => { state.query = event.target.value; renderAll(); });
    }
    function renderHierarchy() {
      const filtered = getFilteredDeities();
      const visibleIds = new Set(filtered.map((d) => d.id));
      $('resultCount').textContent = `当前显示 ${filtered.length} / ${deities.length} 位`;
      $('hierarchyContent').innerHTML = layerOrder.map((layer) => {
        const items = deities.filter((d) => d.layer === layer);
        return `<div class="layer-band" data-layer="${layer}"><div class="flex gap-5"><div class="layer-name title-font flex items-center justify-center rounded border border-yellow-700/30 bg-white/45 py-3 text-xl text-vermilion">${layer}</div><div class="flex flex-1 flex-wrap items-center justify-center gap-5 py-2">${items.map((d) => {
          const visible = visibleIds.has(d.id);
          const highlight = state.query.trim() && (d.name.includes(state.query.trim()) || d.title.includes(state.query.trim()));
          return `<button class="deity-card ${visible ? '' : 'dimmed'} ${highlight ? 'highlight' : ''} relative flex flex-col items-center justify-center p-2 text-center" style="--size:${sizeForRank(d.rank)}px;--ring:${factionColors[d.faction] || '#C41E3A'}" data-id="${d.id}" title="${d.name}｜${d.title}"><span class="deity-mark">${d.short}</span><span class="mt-1 max-w-[92%] truncate text-xs font-semibold text-ink">${d.name}</span><span class="max-w-[90%] truncate text-[10px] text-ink/60">${d.faction}</span></button>`;
        }).join('')}</div></div></div>`;
      }).join('');
      $('hierarchyContent').querySelectorAll('.deity-card').forEach((card) => card.addEventListener('click', (event) => { event.stopPropagation(); openDetail(card.dataset.id); }));
      applyTransform();
      requestAnimationFrame(drawConnectors);
    }
    function drawConnectors() {
      const svg = $('connectorSvg');
      const inner = $('hierarchyInner');
      svg.setAttribute('width', inner.scrollWidth);
      svg.setAttribute('height', inner.scrollHeight);
      svg.innerHTML = '';
      const visibleIds = new Set(getFilteredDeities().map((d) => d.id));
      const innerRect = inner.getBoundingClientRect();
      relations.forEach(([source,target,type,weight]) => {
        if (!visibleIds.has(source) || !visibleIds.has(target)) return;
        const a = inner.querySelector(`[data-id="${source}"]`);
        const b = inner.querySelector(`[data-id="${target}"]`);
        if (!a || !b) return;
        const ar = a.getBoundingClientRect();
        const br = b.getBoundingClientRect();
        const x1 = (ar.left + ar.width / 2 - innerRect.left) / state.zoom;
        const y1 = (ar.top + ar.height / 2 - innerRect.top) / state.zoom;
        const x2 = (br.left + br.width / 2 - innerRect.left) / state.zoom;
        const y2 = (br.top + br.height / 2 - innerRect.top) / state.zoom;
        const path = document.createElementNS('http://www.w3.org/2000/svg','path');
        const midY = (y1 + y2) / 2;
        path.setAttribute('d', `M ${x1} ${y1} C ${x1} ${midY}, ${x2} ${midY}, ${x2} ${y2}`);
        path.setAttribute('fill','none');
        path.setAttribute('stroke', weight >= 4 ? 'rgba(196,30,58,.48)' : 'rgba(180,139,42,.46)');
        path.setAttribute('stroke-width', String(Math.max(1, weight * .55)));
        svg.appendChild(path);
      });
    }
    function initPanZoom() {
      const shell = $('hierarchyShell');
      let dragging = false, startX = 0, startY = 0, baseX = 0, baseY = 0;
      shell.addEventListener('wheel', (event) => {
        event.preventDefault();
        state.zoom = Math.min(1.7, Math.max(.65, state.zoom + (event.deltaY > 0 ? -.08 : .08)));
        applyTransform();
        requestAnimationFrame(drawConnectors);
      }, {passive:false});
      shell.addEventListener('pointerdown', (event) => {
        if (event.target.closest('.deity-card')) return;
        dragging = true; shell.classList.add('dragging');
        startX = event.clientX; startY = event.clientY; baseX = state.panX; baseY = state.panY;
        shell.setPointerCapture(event.pointerId);
      });
      shell.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        state.panX = baseX + event.clientX - startX;
        state.panY = baseY + event.clientY - startY;
        applyTransform();
      });
      shell.addEventListener('pointerup', () => { dragging = false; shell.classList.remove('dragging'); });
      $('resetViewBtn').addEventListener('click', () => { state.zoom = .92; state.panX = 0; state.panY = 0; applyTransform(); requestAnimationFrame(drawConnectors); });
    }
    function openDetail(id) {
      const d = deityById[id];
      if (!d) return;
      const related = relations.filter(([a,b]) => a === id || b === id).map(([a,b,type]) => {
        const other = deityById[a === id ? b : a];
        return other ? `<li><button class="text-left text-azurite underline decoration-yellow-700/30" data-related="${other.id}">${other.name}</button>：${type}</li>` : '';
      }).join('');
      $('detailContent').innerHTML = `<div class="flex items-start gap-4"><div class="deity-card grid place-items-center" style="--size:92px;--ring:${factionColors[d.faction] || '#C41E3A'}"><span class="deity-mark">${d.short}</span></div><div><h3 class="title-font text-3xl font-bold text-vermilion">${d.name}</h3><p class="mt-1 leading-7 text-azurite">${d.title}</p><p class="mt-2 text-sm text-ink/60">${d.faction}｜${d.layer}｜等级 ${d.rank}</p></div></div><div class="mt-6 space-y-5 leading-8"><section><h4 class="title-font text-xl text-azurite">出场回目</h4><p>${d.chapters}</p></section><section><h4 class="title-font text-xl text-azurite">主要事迹</h4><p>${d.deeds}</p></section><section><h4 class="title-font text-xl text-azurite">文化象征</h4><p>${d.symbol}</p></section><section class="rounded border-l-4 border-vermilion bg-white/55 p-4"><h4 class="title-font text-xl text-vermilion">原著依据摘要</h4><p>${d.quote}</p></section><section><h4 class="title-font text-xl text-azurite">相关关系</h4><ul class="mt-2 space-y-2">${related || '<li>暂无已录入关系。</li>'}</ul></section></div>`;
      $('detailContent').querySelectorAll('[data-related]').forEach((btn) => btn.addEventListener('click', () => openDetail(btn.dataset.related)));
      $('detailPanel').classList.add('open');
    }
    function initFactionTabs() {
      $('factionTabs').innerHTML = tabFactions.map((f) => `<button class="tab-btn px-4 py-2 ${f === state.activeTab ? 'active' : ''}" data-tab="${f}">${f}</button>`).join('');
      $('factionTabs').addEventListener('click', (event) => {
        const btn = event.target.closest('[data-tab]');
        if (!btn) return;
        state.activeTab = btn.dataset.tab;
        renderFactionSection();
      });
      renderFactionSection();
    }
    function renderFactionSection() {
      document.querySelectorAll('.tab-btn').forEach((btn) => btn.classList.toggle('active', btn.dataset.tab === state.activeTab));
      const info = factionInfo[state.activeTab];
      $('factionTitle').textContent = info.title;
      $('factionIntro').textContent = info.intro;
      const people = deities.filter((d) => d.faction === state.activeTab || (state.activeTab === '道教' && ['taishang','yuanshi','lingbao','qingniu'].includes(d.id)) || (state.activeTab === '散仙' && ['puti','zhenyuan','sun-wukong','zhu-bajie','sha-seng'].includes(d.id))).slice(0,8);
      $('corePeople').innerHTML = people.map((d) => `<button class="rounded border border-yellow-700/25 bg-white/50 p-3 text-left hover:border-vermilion" data-person="${d.id}"><span class="title-font text-lg text-vermilion">${d.name}</span><span class="mt-1 block text-sm leading-6 text-ink/65">${d.title}</span></button>`).join('');
      $('corePeople').querySelectorAll('[data-person]').forEach((btn) => btn.addEventListener('click', () => openDetail(btn.dataset.person)));
      $('factionEvents').innerHTML = info.events.map((event) => `<li class="flex gap-2"><span class="mt-1 text-vermilion">◆</span><span>${event}</span></li>`).join('');
      renderFactionTree(info.tree);
    }
    function renderFactionTree(treeData) {
      charts.factionTree = charts.factionTree || echarts.init($('factionTree'));
      charts.factionTree.setOption({tooltip:{trigger:'item'},series:[{type:'tree',data:[treeData],top:28,left:20,bottom:22,right:88,symbol:'circle',symbolSize:12,orient:'LR',roam:true,label:{position:'left',verticalAlign:'middle',align:'right',color:'#1C1C1C',fontFamily:'SimSun'},leaves:{label:{position:'right',align:'left'}},lineStyle:{color:'#B48B2A',width:1.3},itemStyle:{color:factionColors[state.activeTab] || '#C41E3A',borderColor:'#FFD700'},expandAndCollapse:true,animationDuration:450}]});
    }
    function renderRelationGraph() {
      charts.relationGraph = charts.relationGraph || echarts.init($('relationGraph'));
      const filtered = getFilteredDeities();
      const visibleIds = new Set(filtered.map((d) => d.id));
      const nodes = filtered.map((d) => ({id:d.id,name:d.name,category:d.faction,symbolSize:22 + d.rank * 8,itemStyle:{color:factionColors[d.faction] || '#C41E3A'},value:d.rank}));
      const links = relations.filter(([a,b]) => visibleIds.has(a) && visibleIds.has(b)).map(([source,target,type,weight]) => ({source,target,value:weight,label:{show:weight >= 4,formatter:type},lineStyle:{width:Math.max(1, weight),opacity:.62}}));
      charts.relationGraph.setOption({tooltip:{formatter:(params) => params.dataType === 'edge' ? params.data.label?.formatter || '关系' : `${params.name}<br/>重要性：${params.value}`},legend:[{data:Object.keys(factionColors).filter((f) => f !== '全部'),bottom:0,textStyle:{color:'#1C1C1C'}}],series:[{type:'graph',layout:'force',roam:true,draggable:true,focusNodeAdjacency:true,categories:Object.keys(factionColors).filter((f) => f !== '全部').map((name) => ({name})),data:nodes,links,label:{show:true,formatter:'{b}',fontFamily:'SimSun',fontSize:12},edgeLabel:{color:'#5B3A29',fontSize:11},lineStyle:{color:'source',curveness:.18},force:{repulsion:180,edgeLength:[72,180],gravity:.08}}]});
      charts.relationGraph.off('click');
      charts.relationGraph.on('click', (params) => { if (params.dataType === 'node') openDetail(params.data.id); });
    }
    function countBy(key, list = deities) { return list.reduce((acc,item) => { acc[item[key]] = (acc[item[key]] || 0) + 1; return acc; }, {}); }
    function renderStats() {
      const counts = countBy('faction');
      charts.pie = charts.pie || echarts.init($('pieChart'));
      charts.pie.setOption({title:{text:'各阵营神仙数量占比',left:'center',textStyle:{fontFamily:'KaiTi',color:'#1C1C1C'}},tooltip:{trigger:'item'},series:[{type:'pie',radius:['38%','68%'],top:30,data:Object.entries(counts).map(([name,value]) => ({name,value,itemStyle:{color:factionColors[name] || '#888'}})),label:{fontFamily:'SimSun'}}]});
      const layerCounts = countBy('layer');
      charts.layer = charts.layer || echarts.init($('layerChart'));
      charts.layer.setOption({title:{text:'各层级神仙数量',left:'center',textStyle:{fontFamily:'KaiTi',color:'#1C1C1C'}},grid:{left:48,right:20,top:58,bottom:70},xAxis:{type:'category',data:Object.keys(layerCounts),axisLabel:{interval:0,rotate:20}},yAxis:{type:'value'},tooltip:{},series:[{type:'bar',data:Object.values(layerCounts),itemStyle:{color:'#1A5276'},barMaxWidth:32}]});
      const originCounts = countBy('origin');
      charts.origin = charts.origin || echarts.init($('originChart'));
      charts.origin.setOption({title:{text:'神仙出身分布',left:'center',textStyle:{fontFamily:'KaiTi',color:'#1C1C1C'}},grid:{left:110,right:24,top:58,bottom:24},xAxis:{type:'value'},yAxis:{type:'category',data:Object.keys(originCounts),axisLabel:{width:96,overflow:'truncate'}},tooltip:{},series:[{type:'bar',data:Object.values(originCounts),itemStyle:{color:'#2E8B57'},barMaxWidth:18}]});
      const appearances = [['孙悟空',96],['唐僧',88],['猪八戒',78],['沙僧',72],['观音菩萨',18],['玉皇大帝',8],['如来佛祖',6],['太上老君',7],['哪吒',5],['牛魔王',4]];
      charts.appear = charts.appear || echarts.init($('appearChart'));
      charts.appear.setOption({title:{text:'代表人物出场频度估计',subtext:'按回目叙事存在感粗略统计，供课堂展示参考',left:'center',textStyle:{fontFamily:'KaiTi',color:'#1C1C1C'}},grid:{left:42,right:20,top:78,bottom:70},xAxis:{type:'category',data:appearances.map((a) => a[0]),axisLabel:{interval:0,rotate:28}},yAxis:{type:'value'},tooltip:{},series:[{type:'line',smooth:true,data:appearances.map((a) => a[1]),symbolSize:9,lineStyle:{color:'#C41E3A',width:3},itemStyle:{color:'#FFD700',borderColor:'#C41E3A',borderWidth:2},areaStyle:{color:'rgba(196,30,58,.12)'}}]});
    }
    function renderAll() {
      document.querySelectorAll('.faction-btn').forEach((btn) => btn.classList.toggle('active', btn.dataset.faction === state.faction));
      renderHierarchy();
      renderRelationGraph();
    }
    function initUtilities() {
      $('closeDetailBtn').addEventListener('click', () => $('detailPanel').classList.remove('open'));
      $('printBtn').addEventListener('click', () => window.print());
      $('graphResetBtn').addEventListener('click', renderRelationGraph);
      $('mobileMenuBtn').addEventListener('click', () => { $('navLinks').classList.toggle('hidden'); $('navLinks').classList.toggle('menu-open'); });
      $('shareBtn').addEventListener('click', () => { $('shareUrlInput').value = location.href; $('shareModal').classList.remove('hidden'); });
      $('closeShareBtn').addEventListener('click', () => $('shareModal').classList.add('hidden'));
      $('copyUrlBtn').addEventListener('click', async () => { try { await navigator.clipboard.writeText($('shareUrlInput').value); $('copyUrlBtn').textContent = '已复制'; setTimeout(() => $('copyUrlBtn').textContent = '复制链接', 1200); } catch (error) { $('shareUrlInput').select(); } });
      $('weiboBtn').addEventListener('click', () => { const url = encodeURIComponent(location.href); const title = encodeURIComponent('《西游记》神仙体系全景图：三界五行，六道轮回'); window.open(`https://service.weibo.com/share/share.php?url=${url}&title=${title}`, '_blank', 'noopener,noreferrer'); });
      let timer = null;
      window.addEventListener('resize', () => { clearTimeout(timer); timer = setTimeout(() => { Object.values(charts).forEach((chart) => chart && chart.resize()); drawConnectors(); }, 120); });
    }
    document.addEventListener('DOMContentLoaded', () => {
      initFilters();
      initPanZoom();
      initFactionTabs();
      initUtilities();
      renderStats();
      renderAll();
    });
  </script>
</body>
</html>
