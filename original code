<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>《西游记》神仙体系全景图</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            vermilion: '#C41E3A',
            imperial: '#FFD700',
            azurite: '#1A5276',
            ink: '#1C1C1C',
            ivory: '#FFFFF0',
            pine: '#2E8B57',
            rice: '#F5F5DC'
          }
        }
      }
    };
  </script>
  <style>
    :root {
      --vermilion: #C41E3A;
      --imperial: #FFD700;
      --azurite: #1A5276;
      --ink: #1C1C1C;
      --ivory: #FFFFF0;
      --pine: #2E8B57;
      --rice: #F5F5DC;
      --gold: rgba(180, 139, 42, .64);
      --hero-image: url("data:image/png;base64,");
    }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      font-family: "宋体", SimSun, serif;
      background:
        radial-gradient(circle at 18% 10%, rgba(255, 215, 0, .12), transparent 22rem),
        radial-gradient(circle at 88% 18%, rgba(196, 30, 58, .08), transparent 20rem),
        linear-gradient(135deg, rgba(255,255,240,.86), rgba(245,245,220,.96)),
        var(--rice);
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        radial-gradient(ellipse at center, transparent 58%, rgba(26,82,118,.04) 59%, transparent 62%),
        radial-gradient(ellipse at center, transparent 56%, rgba(196,30,58,.035) 57%, transparent 60%);
      background-size: 180px 90px, 230px 115px;
      opacity: .75;
    }
    h1, h2, h3, .title-font { font-family: "楷体_GB2312", KaiTi, "STKaiti", serif; }
    .latin { font-family: Georgia, "Times New Roman", serif; }
    .nav-glass {
      background: rgba(255,255,240,.92);
      border-bottom: 1px solid rgba(180,139,42,.28);
      backdrop-filter: blur(16px);
    }
    .gold-card {
      border: 1px solid rgba(180,139,42,.42);
      background: rgba(255,255,240,.86);
      border-radius: 8px;
      box-shadow: 0 14px 32px rgba(28,28,28,.08);
    }
    .hero {
      min-height: min(720px, 88vh);
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(255,255,240,.9), rgba(245,245,220,.72)),
        radial-gradient(circle at 50% 24%, rgba(255,215,0,.24), transparent 15rem),
        linear-gradient(110deg, rgba(26,82,118,.18), transparent 42%),
        var(--hero-image),
        var(--rice);
      background-size: auto, auto, auto, cover, auto;
      background-position: center;
    }
    .hero::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 46%;
      opacity: .42;
      background:
        linear-gradient(150deg, transparent 0 35%, rgba(28,28,28,.24) 35.2% 36%, transparent 36.2%),
        linear-gradient(30deg, transparent 0 39%, rgba(28,28,28,.2) 39.2% 40%, transparent 40.2%),
        linear-gradient(0deg, transparent 0 50%, rgba(28,28,28,.23) 50.2% 51%, transparent 51.2%),
        radial-gradient(ellipse at 50% 95%, rgba(28,28,28,.18), transparent 42%);
      mask-image: linear-gradient(to top, #000, transparent 94%);
